# ---- Backend (never expose these to the frontend) ----
# Provider 1: Backblaze B2 (S3-compatible API)
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=your-application-key-id
B2_APPLICATION_KEY=your-application-key
B2_BUCKET_NAME=your-cloudvault-bucket

# Provider 2: Supabase Storage (private bucket)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET: backend only, never in the frontend
SUPABASE_BUCKET_NAME=cloudvault

# Supabase Postgres (Project Settings -> Database -> Connection string, pooler)
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Free-tier safety limits
MAX_FILE_SIZE=26214400          # 25 MB locally. On Vercel use 4194304 (4 MB): its request-body limit is 4.5 MB
MAX_TOTAL_STORAGE=1073741824    # 1 GB per user (Supabase free storage is 1 GB total, so lower this if you like)
MAX_DAILY_UPLOADS=20
CORS_ORIGINS=http://localhost:5173

# ---- Frontend (frontend/.env) ----
# VITE_API_URL=http://localhost:5000/api
